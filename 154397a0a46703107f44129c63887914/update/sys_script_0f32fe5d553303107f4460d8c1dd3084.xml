        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var engine = new ToolGuardRiskEngine();
    var result = engine.calculateRisk(current);

    // Set Risk Score
    if (current.isValidField('u_risk_score')) {
        current.setValue('u_risk_score', result.score);
    } else {
        current.setValue('risk_score', result.score);
    }

    // Set Explainable AI Reasoning Text
    if (current.isValidField('u_risk_explanation')) {
        current.setValue('u_risk_explanation', result.reason);
    } else if (current.isValidField('u_risk_reasoning')) {
        current.setValue('u_risk_reasoning', result.reason);
    }

})(current, previous);]]></script>
