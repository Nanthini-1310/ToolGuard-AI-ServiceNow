        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    if (!current.u_tool || !current.u_cycles_added) return;

    var toolGr = new GlideRecord('x_snc_toolguard_ai_tool');
    if (toolGr.get(current.u_tool)) {
        var currentCycles = parseInt(toolGr.getValue('u_current_cycles') || '0', 10);
        var addedCycles = parseInt(current.u_cycles_added || '0', 10);
        var newTotal = currentCycles + addedCycles;

        toolGr.setValue('u_current_cycles', newTotal);

        var limit = parseInt(toolGr.getValue('u_lifecycle_limit') || '10000', 10);
        if (newTotal >= limit && toolGr.getValue('u_status') === 'Available') {
            toolGr.setValue('u_status', 'Inspection Required');
        }
        toolGr.update();
    }
})(current, previous);]]></script>
